/* ===================== WORKFLOW: SCROLL STACK (AB TABLET) ===================== */
/* Was hier steht, kann der Designer nicht: nth-child-Regeln,
   Pseudo-Elemente, contain/will-change und das Zuruecknehmen von
   Head-Code-Regeln. Alles andere — inklusive Schlitzkante, Schatten und
   Klebeposition des .workflow-aside — steht im Designer unter Tablet.

   GEAENDERT 04.09. — TITEL-ABSTAND.
   Hier stand vorher ein Navbar-Puffer auf .workflow-aside: padding-top
   von nav-clear plus 16px (also 108px) und ein margin-top von minus
   nav-clear (minus 92px). Der Puffer haelt den Aside-Text beim Kleben
   unter der fixen Navbar — er wirkt aber IMMER, nicht nur im geklebten
   Zustand. Im Ruhezustand sass der Text dadurch 108px unter der
   Ueberschrift, waehrend Service und FAQ bei 48px lagen. Gemessen ueber
   alle Breakpoints: der groesste Ausreisser der Seite.

   Jetzt uebernimmt das der Sticky-Offset. Der Aside klebt im Designer bei
   top:var(--nav-clear) statt bei top:0 und behaelt sein normales
   padding-top von 16px. Die Eigenschaft top wirkt NUR im geklebten
   Zustand, padding wirkt immer — damit ist beides entkoppelt.
   .workflow-stage traegt die restlichen 32px (Designer, medium + tiny),
   32 + 16 = 48px, identisch zu allen anderen Sections.

   Nachgemessen, geklebter Zustand vorher und nachher identisch:
   Aside-Oberkante 92px, Text 108px, erste Karte 295px, Luft dazwischen
   40px. --wf-stick bleibt 295px, der Stapel sitzt also unveraendert.

   WICHTIG fuer Block 42 im JS: --wf-stick wird als asideTop plus
   Aside-Hoehe plus SLOT_OFFSET berechnet. Der asideTop-Summand ist dort
   neu; ohne ihn laege die erste Karte 52px HINTER dem Aside. CSS und JS
   gehoeren hier zusammen. */
@media (max-width: 991px) {

  /* will-change:transform macht den Track zum Containing Block seiner
     Nachfahren, exakt wie ein echtes transform. Sticky-Kinder wuerden
     sich dann auf den Track statt auf den Viewport beziehen. */
  .workflow-track {
    will-change: auto;
    backface-visibility: visible;
    /* Fallback. Den echten Wert schreibt das JS aus der gemessenen
       Aside-Hoehe hierher — CSS und JS teilen sich diese eine Zahl. */
    --wf-stick: 194px;
  }

  /* position:sticky steht auch im Designer, ist dort aber WIRKUNGSLOS:
     der Block "WORKFLOW: CARDS" weiter oben setzt position:relative ohne
     Media Query. Webflows Stylesheet laedt VOR dem Custom Head Code, und
     bei gleicher Spezifitaet gewinnt die spaetere Regel — ein Media Query
     erhoeht die Spezifitaet nicht. Deshalb muss sticky hier stehen.

     ACHTUNG fuer Block 42 im JS: solange eine Karte klebt, liefert
     offsetTop die GEKLEBTE Position, nicht die des Layouts. Das JS misst
     deshalb ueber measureCardTops(), das position kurz auf static setzt. */
  .workflow-card {
    position: sticky;
    top: var(--wf-stick);
    transform-origin: top center;
    /* contain:paint erzeugt ebenfalls einen Containing Block */
    contain: none;
    /* Deckkraft ist Desktop-Logik (Abdunkeln der Nachbarn im Track).
       Im Stapel ist jede sichtbare Karte voll deckend. */
    opacity: 1;

    /* HOEHE = INHALT (Entscheidung Inan, 31.08.).
       Vorher stand hier eine min()-Formel mit 100svh. Zwei Probleme:
       100svh ist auf iOS nicht stabil (wandert mit der URL-Leiste), und
       der Deckel schnitt auf kleinen Geraeten den CTA-Button ab. */
    height: auto;
  }

  /* Der Track enthaelt ausschliesslich die fuenf Karten — nth-child
     zaehlt hier also wirklich Karten. Der 12px-Versatz ist die
     sichtbare Kante jeder verdeckten Karte und MUSS mit STEP im JS
     uebereinstimmen. */
  .workflow-card:nth-child(2) { top: calc(var(--wf-stick) + 12px); }
  .workflow-card:nth-child(3) { top: calc(var(--wf-stick) + 24px); }
  .workflow-card:nth-child(4) { top: calc(var(--wf-stick) + 36px); }
  .workflow-card:nth-child(5) { top: calc(var(--wf-stick) + 48px); }

  /* Innenschein aus: der gehoert zur aktiven Karte im horizontalen Track */
  .workflow-card::after { opacity: 0; }

  /* Chrome-Kante nur auf der obersten Karte des Stapels. */
  .workflow-card::before { opacity: 0; }
  .workflow-card.is-active::before {
    opacity: 0.75;
    transition: opacity 320ms ease;
  }

  /* --- ZIFFER: gestreckt und mittig in der Karte ---
     Es bleiben genau die zwei Werte, die auf Mobile anders sind:
     padding-bottom 0 = keine Hoehenverschiebung, die Flex-Zentrierung der
     Basisregel greift wieder auf die volle Kartenhoehe (top:0/bottom:0).
     translateX(-50%) MUSS vorne stehen bleiben, sonst wird der Versatz
     mitskaliert und die Ziffer sitzt schief. */
  .workflow-numeral {
    padding-bottom: 0;
    transform: translateX(-50%) scaleX(1.9) scaleY(0.70);
  }
}

@media (prefers-reduced-motion: reduce) {
  .workflow-stage { display: block; min-height: 0; overflow: visible; }
  .workflow-track {
    flex-direction: column;
    transform: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  .workflow-card {
    position: relative;
    top: auto;
    width: 100%;
    height: auto;
    flex-basis: auto;
    opacity: 1;
    transform: none !important;
    transition: none;
  }
  /* Nimmt die Designer-Werte der Schlitzkante zurueck */
  .workflow-aside {
    position: static;
    transform: none;
    width: 100%;
    padding: 0 0 32px;
    background-color: transparent;
    box-shadow: none;
  }
  .workflow-mask,
  .workflow-slot { display: none; }
  .workflow-card::before,
  .workflow-card::after { opacity: 0; }
}


<style>
/* ===================== ABOUT: TITEL-STACK + WORT-REVEAL ===================== */
/* Container versteckt, bis das JS Wörter zerlegt und Startzustände gesetzt hat */
.fade-ready [data-reveal] { opacity: 0; }

/* Stack ist exakt viewporthoch und wird selbst gepinnt (Desktop) bzw.
   geklebt (Mobile, Block 50). Deshalb sitzt der Titel mittig, unabhängig
   vom Section-Padding.

   HOEHE: var(--vh-lock) statt 100svh. Gemessen am iPhone (31.08.):
   min-height:100svh wandert live zwischen 637 und 737px, waehrend die
   URL-Leiste faehrt. ScrollTrigger.config({ignoreMobileResize:true})
   unterdrueckt das Remeasurement — der gepinnte Stack war dadurch am Ende
   hoeher als der fuer ihn reservierte Platz. --vh-lock wird im Site-Head
   EINMAL gesetzt und nur bei Breitenaenderung neu gemessen.
   100svh bleibt als Fallback, falls das Inline-Script nicht laeuft. */
[data-title-stack] {
  display: grid;
  place-items: center;
  min-height: var(--vh-lock, 100svh);
  perspective: 1000px;          /* Fluchtpunkt für das Kippen */
  perspective-origin: 50% 50%;
}
[data-title-stack] > * {
  grid-area: 1 / 1;             /* alle übereinander, gleiche Stelle */
  margin: 0;
  text-align: center;
  backface-visibility: hidden;  /* verhindert Flackern beim Kippen */
}

/* Abstand Titel -> Text. Stellschraube für den Rhythmus der Section. */
[data-reveal="text"] { margin-top: 15vh; }

/* Jedes Wort ein eigener Layer. inline-block, weil transform
   auf reinen inline-Elementen nicht greift. */
.reveal-word {
  display: inline-block;
  white-space: pre-wrap;
}

@media (prefers-reduced-motion: reduce) {
  /* Stack auflösen — drei Titel übereinander wären sonst unlesbar */
  [data-title-stack] { display: block; min-height: 0; }
  [data-title-stack] > * { grid-area: auto; }
  [data-reveal="text"] { margin-top: 0; }
  .fade-ready [data-reveal] { opacity: 1 !important; }
  .reveal-word {
    opacity: 1 !important;
    filter: none !important;
    transform: none !important;
  }
}
</style>

<style>
/* ===================== SECTION: SERVICE — BENTO VIDEO ===================== */

/* Webflows Embed-Wrapper muss die volle Kartenhöhe durchreichen,
   sonst kollabiert das Video auf Inhaltshöhe. */
[data-bento-video] .w-embed {
  width: 100%;
  height: 100%;
}

/* Das Video füllt die Karte aus. aspect-ratio 16/9, overflow:hidden
   und der Radius kommen aus der Designer-Klasse .service-vid. */
.bento-video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* Dunkle Fläche, solange nichts geladen ist — kein weißes Aufblitzen */
  background-color: #0D0D0D;
}

/* ===================== SECTION: SERVICE — LICHT VOM VIDEO ===================== */

/* Ruhewerte. Farbe und Staerke getrennt, damit der Verlauf unten
   pro Stop eine eigene Deckkraft bekommen kann.
   Alle vier werden zur Laufzeit vom Video-Sampling ueberschrieben. */
.service-card {
  --spill-rgb: 176, 205, 245;  /* Lichtfarbe */
  --spill-a: 0.13;             /* Lichtstaerke */
  --ray-rot: 0deg;             /* Drift der Lichtstrahlen */
  --ray-gain: 1;               /* Atmung der Strahlen-Intensitaet */
}

/* Nur der Stretch steht hier — Webflows Transform-Panel kann keinen
   reinen horizontalen Stretch (gleicher Grund wie bei .workflow-numeral).
   Schriftgroesse, Position und Randabstand gehoeren in den Designer. */
@media (min-width: 992px) {
  .service-card-index.is-left  { transform: scaleX(5); transform-origin: 0% 50%; }
  .service-card-index.is-right { transform: scaleX(5); transform-origin: 100% 50%; }
}

@media (max-width: 991px) {
  .service-card-index.is-left  { transform: scaleX(1.4); transform-origin: 0% 50%; }
  .service-card-index.is-right { transform: scaleX(1.4); transform-origin: 100% 50%; }

  /* Die beiden Desktop-Karten sind unter 992px auf Hoehe 0 gefahren
     (gemessen: height 0, display:flex, overflow:hidden). Sichtbar sind
     sie damit nicht — im Accessibility-Tree und fuer Suchmaschinen aber
     schon: ein Screenreader liest beide Texte vor, ohne dass etwas da
     ist. content-visibility nimmt sie sauber heraus, ohne die
     bestehende Hoehen-Mechanik anzufassen.
     ANMERKUNG: dass auf Mobile nur EINE der drei Service-Karten
     erscheint, ist eine inhaltliche Frage, keine technische. */
  .service-card.is-left,
  .service-card.is-right {
    content-visibility: hidden;
  }
}

/* Grundschein von unten. Grosse Ausdehnung (200% 150%) plus sieben Stops:
   das Licht reicht weit in die Karte hinein und faellt als weiche Kurve ab
   statt als gerade Linie. */
.service-card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image: radial-gradient(
    200% 150% at 50% 132%,
    rgba(var(--spill-rgb), var(--spill-a))                  0%,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.70))    18%,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.45))    34%,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.26))    50%,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.13))    66%,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.05))    82%,
    rgba(var(--spill-rgb), 0)                             100%
  );
}

/* Lichtstrahlen — bewusst KEIN Wechsel zwischen Strahl und Nichts.
   Der niedrigste Wert (0.05) ist ungleich null, der hoechste nur 0.16:
   dadurch modulieren die Strahlen einen durchgehenden Schein, statt als
   einzelne Streifen zu lesen. Periode 68deg = nur wenige, sehr breite
   Baender. Bewegt wird der Winkel, NICHT das Element — ein transform
   wuerde die Maske mitdrehen. */
.service-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image: repeating-conic-gradient(
    from calc(174deg + var(--ray-rot)) at 50% 132%,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.05 * var(--ray-gain)))   0deg,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.10 * var(--ray-gain)))  10deg,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.2 * var(--ray-gain)))  20deg,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.10 * var(--ray-gain)))  30deg,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.05 * var(--ray-gain)))  40deg,
    rgba(var(--spill-rgb), calc(var(--spill-a) * 0.05 * var(--ray-gain)))  68deg
  );
  /* Blendet die Strahlen nach oben aus, damit sie unten ansetzen
     und oben in nichts uebergehen. */
  -webkit-mask-image: radial-gradient(140% 110% at 50% 132%, #000 0%, transparent 66%);
          mask-image: radial-gradient(140% 110% at 50% 132%, #000 0%, transparent 66%);
}
</style>
